{
  "manifest_version": 3,
  "name": "1-Click Video Downloader",
  "version": "1.0.0",
  "description": "Toolbar button e 1 click e current page er video computer e download (yt-dlp diye).",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "notifications", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Ei page er video download korun (1 click)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
