{
  "manifest_version": 3,
  "name": "1-Click Video Downloader",
  "version": "1.1.0",
  "description": "IDM-er moto video-r upor Download button: quality ar folder bachai kore 1000+ site theke video download (yt-dlp).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "1 click e best quality download (last folder e)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}